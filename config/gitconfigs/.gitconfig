[include]
    path = ~/.gitconfig-local


[apply]
  ignorewhitespace = change
  whitespace = nowarn

[core]
	autocrlf = input
    pager = diff-so-fancy | less --tabs=4 -RF
    editor = nvim
	excludesFile = ~/.dotfiles/config/gitconfigs/.gitignore
    # Speed up `git status` — caches untracked file info per-directory.
    # Note: core.fsmonitor does NOT work on NFS (our home dir is NFS-mounted),
    #       so only untrackedcache is enabled.
    untrackedcache = true

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
    required = true

[alias]
    br = branch
    ci = commit
    undo = reset --soft HEAD^
    up = pull --rebase
    co = "!f() { git checkout \"$@\" && git submodule update --init --recursive; }; f"
    lg = log --oneline --graph --decorate --all
    supdate = !git submodule update --remote --merge
    resign = "!f() { git rebase --exec 'git commit --amend --no-edit -n -S' -i \"$1\"; }; f"
    squash = "!f() { \
        base=$(git merge-base HEAD \"${1:-origin/main}\"); \
        if [ \"$base\" = \"$(git rev-parse HEAD)\" ]; then \
            echo 'nothing to squash'; return 1; \
        fi; \
        git reset --soft \"$base\" && git commit; \
    }; f"
    pushf = push --force-with-lease
    gone = "!git fetch --prune && git branch -vv | awk '/: gone]/{print $1}' | xargs -r git branch -d"
	fresh = "!f() { [ -z \"$1\" ] && echo \"usage: git fresh <branch>\" && return 1; if [ -z \"$(git status --porcelain)\" ]; then echo \"Working tree clean, nothing to stash.\"; else git stash -q; echo \"Stashed changes.\"; fi; git fetch origin && git reset --hard origin/$1; echo \"\"; echo \"Stash list:\"; git stash list; echo \"\"; echo \"Run: git stash pop              (pop most recent)\"; echo \"Run: git stash pop stash@{n}   (pop specific)\"; }; f"

[interactive]
	diffFilter = diff-so-fancy --patch

[color]
    ui = true
    interactive = true
    branch = true
    status = true

[color "diff-highlight"]
	oldNormal = red bold
	oldHighlight = red bold 52
	newNormal = green bold
	newHighlight = green bold 22

[color "diff"]
	meta = 11
	frag = magenta bold
	func = 146 bold
	commit = yellow bold
	old = red bold
	new = green bold
    whitespace = red reverse

[commit]
    gpgsign = true

[gpg]
    format = ssh

[init]
    defaultBranch = main

[push]
	autoSetupRemote = true


[pull]
	ff = only
[fetch]
	prune = true
[worktree]
	guessRemote = true
